    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"user_intent\": \"2026년 반도체 시장 전망과 글로벌 관세 정책의 영향 분석\",\n  \"search_plan\": [\n    {\n      \"route\": \"economy\",\n      \"query\": \"2026년 한국 경제 산업별 전망 및 반도체 수출 지표\",\n      \"reason\": \"내부 경제 전망 PDF에 수록된 거시 경제 지표 및 산업별 성장률 확인\"\n    },\n    {\n      \"route\": \"it\",\n      \"query\": \"2026년 AI 반도체 기술 트렌드 및 지능형 반도체 로드맵\",\n      \"reason\": \"내부 테크 트렌드 PDF에 수록된 차세대 반도체 및 AI 기술 동향 확인\"\n    },\n    {\n      \"route\": \"web\",\n      \"query\": \"2026년 미국 및 주요국 반도체 추가 관세 및 무역 규제 현황\",\n      \"reason\": \"RAG(PDF) 자료에는 없는 실시간 정치/외교적 규제 변수 확보\"\n    }\n  ]\n}"
