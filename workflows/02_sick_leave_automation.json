    {
      "parameters": {
        "jsCode": "// Get row(s) 결과 전체\nconst rows = $input.all();\n\n// id만 뽑아서 숫자로 변환\nconst ids = rows\n  .map(item => Number(item.json.id))\n  .filter(id => !isNaN(id));\n\n// 최대 id 계산\nconst maxId = ids.length ? Math.max(...ids) : 0;\n\n// 다음 id\nconst nextId = maxId + 1;\n\nconst text = $('Webhook').first().json.body.text || '';\nconst parts = text.trim().split(/\\s+/);\n\nconst name = parts[0] ?? '';\nconst start_date = parts[1] ?? '';\nconst end_date = parts[2] ?? '';\n\n// ✅ 추가: 중복 행의 row_number를 담을 변수\nlet matchedRowNumber = null;\n\n// ✅ 날짜 문자열(YYYY-MM-DD)을 안전하게 숫자(ms)로 변환\nconst toTime = (d) => {\n  if (!d) return NaN;\n  // 로컬 타임존 이슈 피하려고 UTC로 고정\n  const t = Date.parse(d + 'T00:00:00Z');\n  return Number.isNaN(t) ? NaN : t;\n};\n\nconst inStart = toTime(start_date);\nconst inEnd   = toTime(end_date);\n\n// 중복 여부 판단 (이름이 같고, 기간이 겹치면)\nconst exists = rows.some(item => {\n  const r = item.json;\n\n  const rName = (r.name ?? '');\n  if (rName !== name) return false;\n\n  const rStart = toTime(r.start_date ?? '');\n  const rEnd   = toTime(r.end_date ?? '');\n\n  // 날짜가 비정상이면 비교 제외(원하면 true로 처리도 가능)\n  if ([inStart, inEnd, rStart, rEnd].some(Number.isNaN)) return false;\n\n  // ✅ 기간 겹침(포함) 판정\n  const overlaps = (inStart <= rEnd) && (inEnd >= rStart);\n\n  if (overlaps) {\n    matchedRowNumber = r.row_number; // ✅ 겹친 행 row_number 저장\n    return true;\n  }\n  return false;\n});\n\nreturn [{\n  json: {\n    id: nextId,\n    name,\n    start_date,\n    end_date,\n    description: parts.slice(3).join(' ') ?? '',\n    flag: '',\n    exists,\n    matchedRowNumber, // exists=true면 숫자, 아니면 null\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
